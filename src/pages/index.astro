---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tile from "../layouts/Tile.astro";
import MoreTile from "../layouts/MoreTile.astro";
import { SITE_EMAIL } from "../consts";
const allPosts = await Astro.glob("../pages/posts/*.md");
allPosts.sort((a, b) => Date.parse(b.frontmatter.pubDate) - Date.parse(a.frontmatter.pubDate));
---

<BaseLayout>
  <section class="profile-section">
    <div class="section-content">
      <div class="profile-content">
        <div class="profile-info">
          <h2 class="profile-name">Yu (Terry) Deng</h2>
          <h2 class="profile-email">{SITE_EMAIL}</h2>
          <p class="profile-description">
          I am a PhD student in Management Science and Engineering at Xi’an Jiaotong University, focusing on machine learning. I joined in September 2026. My research interests span information systems, cybersecurity, and AI security, including large language model security and Zero Trust Architecture. Previously, I completed my master’s studies in Business Information Systems at the University of Canterbury, New Zealand, where I worked with Dr. <a href="https://profiles.canterbury.ac.nz/Anushia-Inthiran">Anushia Inthiran</a>.
          <br />In my free time, I enjoy snowboarding and playing Counter-Strike.
          </p>
          <p class="profile-link">
<!--
            <a href="https://github.com/Terryyyds/blog/raw/main/src/pages/CV.pdf" target="_blank">CV</a>&nbsp;&nbsp;|&nbsp;&nbsp;
-->
            
            <a class="social-link" href="https://terryyyds.github.io/AcademicPage/" target="_blank" rel="noopener noreferrer">Academic Profile</a>&nbsp;&nbsp;|&nbsp;&nbsp;

            <a class="social-link" href="https://www.linkedin.com/in/yu-deng-396901303/" target="_blank">
            <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linkedin/linkedin-original.svg"
                class="social-icon"
                alt="LinkedIn icon"
              />
              LinkedIn
            </a>&nbsp;&nbsp;|&nbsp;&nbsp;

            <a
                id="cy-effective-orcid-url"
                class="underline social-link"
                href="https://orcid.org/0009-0002-3688-7793"
                target="orcid.widget"
                rel="me noopener noreferrer">
                <img
                    src="https://orcid.org/sites/default/files/images/orcid_16x16.png"
                    class="social-icon"
                    alt="ORCID iD icon"
                />
                ORCID
            </a>&nbsp;&nbsp;|&nbsp;&nbsp;

            <a class="social-link" href="https://scholar.google.com/citations?user=pIgLDYkAAAAJ" target="_blank">
              <img
                src="https://scholar.google.com/favicon.ico"
                class="social-icon"
                alt="Google Scholar icon"
              />
              Scholar
            </a>&nbsp;&nbsp;
          </p>
        </div>
        <div class="profile-photo">
          <img src="https://s2.loli.net/2025/12/09/LVogGmbTOskxQNH.jpg" alt="Yu (Terry) Deng" />
        </div>
      </div>
    </div>
  </section>

  <section class="everydayfeed">
    <div class="section-content">
      <h2 class="section-head">News</h2>
        <ul role="list" class="news-list">
          <li>[09/2026] Joined Xi’an Jiaotong University as a PhD student in Management Science and Engineering.</li>
          <li>[07/2026] Presented our paper on Zero Trust Architecture and SME security readiness at PACIS 2026 in Jakarta, Indonesia.</li>
          <li>[01/2026] Earned the Splunk Core Certified Power User certification.</li>
          <li>[11/2025] Co-authored MILE, a preprint on data collection for dexterous robotic manipulation.</li>
          <li>[08/2025] Joined Cloudfall (Shanghai) Ltd as a security analyst.</li>
          <li>[07/2025] Graduated from UC with multiple First in Class Academic Performance Prizes!</li>
          <li>[01/2025] Achieved NISP-II & CISP certificates.</li>
          <li>[12/2024] Joined Humanoid Robot (Shanghai) Ltd as a desktop security operations intern.</li>
          <li>[10/2024] Achieved NISP-I & Google Cybersecurity Certificates.</li>
          <li>[06/2024] Joined Business Canterbury (New Zealand) Ltd as an Information Security Consultant intern.</li>
          <!-- <li>[03/2024] Invited talk at <a href="https://www.techbeat.net/talk-info?id=854">TechBeat</a></li> -->

          <li>[02/2024] Completed external penetration test project for Humbleify and wrote a <a href="/posts/MBIS622">report</a>.</li>
          <li>[10/2023] Personal blog terrylog.cn went live. </li>
        </ul>
    </div>
  </section>

  <section class="everydayfeed">
    <div class="section-content">
      <h2 class="section-head">Recent Posts</h2>
      <ul role="list" class="section-tiles">
        {
          // tile-hero
          allPosts.slice(0, 1).map((post) => {
            return (
              <Tile title={post.frontmatter.title} href={post.url} date={post.frontmatter.pubDate} tags={post.frontmatter.tags} cover={post.frontmatter.cover.url} level="1" />
            );
          })
        }

        {
          // tile-2up
          allPosts.slice(1, 5).map((post) => {
            return (
              <Tile title={post.frontmatter.title} href={post.url} date={post.frontmatter.pubDate} tags={post.frontmatter.tags} cover={post.frontmatter.cover.url} level="2" />
            );
          })
        }

        {
          // tile-3up
          allPosts.slice(5, 11).map((post) => {
            return (
              <Tile title={post.frontmatter.title} href={post.url} date={post.frontmatter.pubDate} tags={post.frontmatter.tags} cover={post.frontmatter.cover.url} level="3" />
            );
          })
        }
      </ul>
    </div>
    <div class="view-archive-wrapper">
        <a href="/archive" class="cta-primary-light" data-analytics-region="router" data-analytics-title="view archive">查看所有文章</a>
    </div>
  </section>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      var script = document.createElement("script");
      script.src = "/static/js/animation.js";
      document.head.appendChild(script);

      script.onload = function () {
        console.log("lazyload.js loaded");
        // when layout is loaded, load the images
        initImage();
      };
    });
  </script>
</BaseLayout>

<style>
  html, body {
    min-width: 400px;
    width: 100%;
    height: 100%;
  }
  .profile-section {
    margin-bottom: 40px;
    margin-top: 40px;
  }
  
  .profile-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .profile-info {
    max-width: 60%;
  }
  
  .profile-name {
    font-family: "Helvetica Neue", "SF Pro Text", Arial, sans-serif;
    font-weight: normal;
    font-size: 2rem; 
  }

  .profile-email {
    font-family: "Helvetica Neue", "SF Pro Text", Arial, sans-serif;
    font-size: smaller;
    font-weight:normal;
  }
  
  .profile-description {
    font-family: "Helvetica Neue", "SF Pro Text", Arial, sans-serif;
    font-size: smaller;
    color: #555;
    line-height: 1.6;
  }

  .profile-link {
    font-family: "Helvetica Neue", "SF Pro Text", Arial, sans-serif;
    font-size: smaller;
    color: #555;
    line-height: 1.6;
  }


  .profile-photo {
    flex-shrink: 0;
    margin-left: 25px;
    width: 150px; /* 设置固定宽度 */
    height: 150px; /* 设置固定高度，确保容器是正方形 */
    overflow: hidden; /* 确保图片不会超出容器 */
    border-radius: 50%; /* 设置圆形边框 */
  }
  
  .profile-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* 确保图片覆盖容器并保持比例 */
    display: block; /* 去除图片底部的空隙 */
  }


  .news-list {
    font-family: "Helvetica Neue", "SF Pro Text", Arial, sans-serif;
    font-size: medium;
  }

  .news-list ul {
    font-family: "Helvetica Neue", "SF Pro Text", Arial, sans-serif;
    font-size: medium;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    vertical-align: middle;
  }

  .social-icon {
    width: 1em;
    height: 1em;
    display: inline-block;
  }

  @media only screen and (max-width: 734px) {
    html, body {
      min-width: 320px;
    }

    .profile-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 80px;
      grid-template-areas:
        "name photo"
        "email photo"
        "description description"
        "links links";
      column-gap: 16px;
      row-gap: 8px;
      align-items: center;
    }

    .profile-info {
      display: contents;
    }

    .profile-name {
      grid-area: name;
      margin: 0;
      font-size: 1.5rem;
    }

    .profile-email {
      grid-area: email;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .profile-description {
      grid-area: description;
      margin: 16px 0 0;
    }

    .profile-link {
      grid-area: links;
      margin: 8px 0 0;
    }

    .profile-photo {
      grid-area: photo;
      margin-left: 0;
      width: 80px;
      height: 80px;
    }
  }

</style>
